# macOS Finder metadata
.DS_Store
# Jupyter's autosave copies of notebooks
.ipynb_checkpoints/
# R session files: RStudio's project state, the saved workspace and the
# command history
.Rproj.user/
.RData
.Rhistory
.Ruserdata
# Study 1's saved model files. The runs write them again, and the saved
# Bayesian fits record the full path of the folder they were saved in
Analysis/R Analysis Pipeline/Study 1/models/*.rds
# LaTeX's build files for the manuscript and its Supplementary Information
Docs/Writing/Final Paper/*.aux
Docs/Writing/Final Paper/*.log
Docs/Writing/Final Paper/*.fdb_latexmk
Docs/Writing/Final Paper/*.fls
Docs/Writing/Final Paper/*.out
Docs/Writing/Final Paper/*.bbl
Docs/Writing/Final Paper/*.blg
Docs/Writing/Final Paper/*.toc
Docs/Writing/Final Paper/*.synctex.gz
# The manuscript, held back until the authors release it. Analysis runs still
# write copies of their tables and figures into it
Docs/Writing/

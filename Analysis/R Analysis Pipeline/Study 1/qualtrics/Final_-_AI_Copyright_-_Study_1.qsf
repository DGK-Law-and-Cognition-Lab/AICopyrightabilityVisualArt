questions.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_2hHhyj6NDuZB6WG","Element":"SQ","PrimaryAttribute":"QID167","SecondaryAttribute":"Was any part of the procedure unclear? Did you have any problems completing any of the tasks? If...","TertiaryAttribute":null,"Payload":{"QuestionText":"Was any part of the procedure unclear? Did you have any problems completing any of the tasks? If none, type NA.","DefaultChoices":false,"DataExportTag":"CommentFeedback","QuestionID":"QID167","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Was any part of the procedure unclear? Did you have any problems completing any of the tasks? If...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_2hHhyj6NDuZB6WG","Element":"SQ","PrimaryAttribute":"QID168","SecondaryAttribute":"What is your gender?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your gender?","DataExportTag":"Gender","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your gender?","Choices":{"1":{"Display":"Male"},"2":{"Display":"Female"},"3":{"Display":"Other"},"4":{"Display":"Prefer not to say"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID168"}},{"SurveyID":"SV_2hHhyj6NDuZB6WG","Element":"SQ","PrimaryAttribute":"QID169","SecondaryAttribute":"What is your age?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your age?","DefaultChoices":false,"DataExportTag":"Age","QuestionID":"QID169","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your age?","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_2hHhyj6NDuZB6WG","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"Alex looked at the first artwork, and decided to produced a secondary digital artwork. \u00a0 Using th..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">Alex looked at the first artwork, and decided to produced a secondary digital artwork. &nbsp;<br>\n<br>\nUsing the first work as a base, he produced a second digital artwork with his <i>graphic design software and digital sketching tools<\/i>.&nbsp;<\/div><div style=\"text-align: center;\"><br><\/div><div style=\"text-align: center;\">\nClick the arrow to see the digital artworks:<\/div>","DefaultChoices":false,"DataExportTag":"SecondPartVignette1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Alex looked at the first artwork, and decided to produced a secondary digital artwork. \u00a0 Using th...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID17"}},{"SurveyID":"SV_2hHhyj6NDuZB6WG","Element":"SQ","PrimaryAttribute":"QID170","SecondaryAttribute":"We are studying how humans perceive the copyrightability of artificial intelligence art. Current...","TertiaryAttribute":null,"Payload":{"QuestionText":"We are studying how humans perceive the copyrightability of artificial intelligence art. Current legal standards state that anything produced with artificial intelligence is insufficiently creative, even if you use AI as a base against which you create new work. There is ongoing litigation against the US Copyright Office with an analogous set of facts that you have seen here. If you have any questions, please feel free to contact the researcher David G. Kamper at davidgkamper@ucla.edu.","DefaultChoices":false,"DataExportTag":"Final Review","QuestionID":"QID170","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"We are studying how humans perceive the copyrightability of artificial intelligence art. Current...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_2hHhyj6NDuZB6WG","Element":"SQ","PrimaryAttribute":"QID171","SecondaryAttribute":"Please select the \"arrow\" button to complete the experiment","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">Please select the &quot;arrow&quot; button to complete the experiment<\/div>","DefaultChoices":false,"DataExportTag":"Finish","QuestionID":"QID171","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please select the \"arrow\" button to complete the experiment","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_2hHhyj6NDuZB6WG","Element":"SQ","PrimaryAttribute":"QID1718715759","SecondaryAttribute":"CONSENT FORM You are invited to participate in a research study on human thinking and artistic an...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><b>CONSENT FORM<\/b><\/div><br>You are invited to participate in a research study on human thinking and artistic and aesthetic judgment, conducted by Dr. Keith J. Holyoak, of the Department of Psychology at UCLA. You were selected as a possible participant in this study because you are 18 years of age or older.\n<br>\n<br>\n<b>Purpose of Study<\/b><br>\nThe purpose of the study is to understand human artistic perception and cognition.\n<br>\n<br>\n<b>Procedures Involved in Study<\/b><br>\nIf you agree to participate, you may receive a demographic questionnaire to collect information on your age, gender, language, and artistic background. You may be presented with different types of visual art and asked to answer simple questions and\/or perform simple tasks by interacting with a website via a keyboard or a computer mouse. Your responses will be recorded by the computer and will not be identified with you in any way. The session will take less than 60 minutes.\n<br>\n<br>\n<b>Potential Risks and Discomforts<\/b><br>\nThere is no known risk or discomfort in this study. If you experience any discomfort during the experiment, you can stop at any time and notify the experimenter.<br>\n<br>\n<b>Potential Benefits to Subject<\/b><br>\nThere are no direct benefits from participating in this study.<br>\n<br>\n<b>Potential Benefits to Society<\/b><br>\nThe findings of the study will help us understand how humans perceive and understand aesthetic judgements in the law. By understanding the processes underlying human perception, we can better consider the fundamentals of copyright and the burgeoning field of AI art.  \n<br>\n<br>\n<b>Payment for Participation<\/b><br>\nYou will receive 0.5 to 1 hour of credit for your psychology class if you signed up for the study through the UCLA Psychology Department Subject Pool; otherwise, you will receive payment at the rate of $16 per hour for your participation.<br>\n<br>\n<b>Alternatives to Participation<\/b><br>\nAn alternative to participating in this project and fulfilling Psychology 10 requirements is to participate in other research or to do an equivalent classroom project.<br>\n<br>\n<b>Confidentiality<\/b><br>\nYour identity in this study will be treated as confidential. The results of the study, including laboratory or any other data, may be published for scientific purposes but will not include any identifiable references to you. Your data, including de-identified data, may be kept for use in future research. After the experiment has finished running, all contact information will be destroyed. Only the researchers will have access to registration and data files. The data files that you submit will be stored for 5 years.<br>\n<br>\nThe researchers will do their best to ensure that your private information is kept confidential. Information about you will be handled as confidentially as possible, but participating in research may involve a loss of privacy and the potential for a breach in confidentiality. Study data will be physically and electronically secured. As with any use of electronic means to store data, there is a risk of breach of data security.<br>\n<br>\n<b>Participation and Withdrawal<\/b><br>\nYour participation is VOLUNTARY. You may withdraw from the experiment at any time without suffering any negative consequences. You may refuse to answer any questions that you do not want to answer and remain in the study.<br>\n<br>\n<b>Identification of Investigators<\/b><br>\nIf you have any questions, feel free to contact Co-Principal Investigator David G. Kamper (davidgkamper@ucla.edu) or Principal Investigator Keith Holyoak (kholyoak@g.ucla.edu) at the Department of Psychology, UCLA, 405 Hilgard Ave., Los Angeles, CA 90095-1563. <br>\n<br>\n<b>Rights of Research Subjects<\/b><br>\nYou may withdraw your consent at any time and discontinue participation without penalty. You are not waiving any legal claims, rights, or remedies because of your participation in this research study.<br>\n<br>\n<b>UCLA Office of the Human Research Protection Program (OHRPP)<\/b><br>\nIf you have questions about your rights as a research subject, or you have concerns or suggestions and you want to talk to someone other than the researchers, you may contact the UCLA OHRPP by phone: (310) 206-2040; by email: participants@research.ucla.edu or by mail: Box 951406, Los Angeles, CA 90095-1406.","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"CONSENT FORM You are invited to participate in a research study on human thinking and artistic an...","Choices":{"1":{"Display":"I consent to this study."},"2":{"Display":"I do not consent to this study."}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\"><b>CONSENT FORM<\/b><\/div><br>You are invited to participate in a research study on human thinking and music, conducted by Dr. Keith J. Holyoak, of the Department of Psychology at UCLA. You were selected as a possible participant in this study because you are 18 years of age or older.<br>\n<br>\n<b>Purpose of Study<\/b><br>\nThe purpose of the study is to understand human auditory perception and cognition.<br>\n<br>\n<b>Procedures Involved in Study<\/b><br>\nIf you agree to participate, you may receive a demographic questionnaire to collect information on your age, gender, language, and musical background. You may be presented with audio clips and asked to answer simple questions and\/or perform simple tasks by interacting with a website via a keyboard or a computer mouse. Your responses will be recorded by the computer and will not be identified with you in any way. The session will take less than 60 minutes.<br>\n<br>\n<b>Potential Risks and Discomforts<\/b><br>\nThere is no known risk or discomfort in this study. If you experience any discomfort during the experiment, you can stop at any time and notify the experimenter.<br>\n<br>\n<b>Potential Benefits to Subject<\/b><br>\nThere are no direct benefits from participating in this study.<br>\n<br>\n<b>Potential Benefits to Society<\/b><br>\nThe findings of the study will help us understand how humans perceive and understand musical similarity. By understanding the processes underlying human perception, we will be able to design better machine vision systems.<br>\n<br>\n<b>Payment for Participation<\/b><br>\nYou will receive 1 hour of credit for your psychology class if you signed up for the study through the UCLA Psychology Department Subject Pool; otherwise, you will receive payment at the rate of $10 per hour for your participation.<br>\n<br>\n<b>Alternatives to Participation<\/b><br>\nAn alternative to participating in this project and fulfilling Psychology 10 requirements is to participate in other research or to do an equivalent classroom project.<br>\n<br>\n<b>Confidentiality<\/b><br>\nYour identity in this study will be treated as confidential. The results of the study, including laboratory or any other data, may be published for scientific purposes but will not include any identifiable references to you. Your data, including de-identified data, may be kept for use in future research. After the experiment has finished running, all contact information will be destroyed. Only the researchers will have access to registration and data files. The data files that you submit will be stored for 5 years.<br>\n<br>\nThe researchers will do their best to ensure that your private information is kept confidential. Information about you will be handled as confidentially as possible, but participating in research may involve a loss of privacy and the potential for a breach in confidentiality. Study data will be physically and electronically secured. As with any use of electronic means to store data, there is a risk of breach of data security.<br>\n<br>\n<b>Participation and Withdrawal<\/b><br>\nYour participation is VOLUNTARY. You may withdraw from the experiment at any time without suffering any negative consequences. You may refuse to answer any questions that you do not want to answer and remain in the study.<br>\n<br>\n<b>Identification of Investigators<\/b><br>\nIf you have any questions, feel free to contact Co-Principal Investigator David G. Kamper (davidgkamper@ucla.edu) or Principal Investigator Keith Holyoak (kholyoak@g.ucla.edu) at the Department of Psychology, UCLA, 405 Hilgard Ave., Los Angeles, CA 90095-1563.<br>\n<br>\n<b>Rights of Research Subjects<\/b><br>\nYou may withdraw your consent at any time and discontinue participation without penalty. You are not waiving any legal claims, rights, or remedies because of your participation in this research study.<br>\n<br>\n<b>UCLA Office of the Human Research Protection Program (OHRPP)<\/b><br>\nIf you have questions about your rights as a research subject, or you have concerns or suggestions and you want to talk to someone other than the researchers, you may contact the UCLA OHRPP by phone: (310) 206-2040; by email: participants@research.ucla.edu or by mail: Box 951406, Los Angeles, CA 90095-1406.","DataExportTag":"ConsentForm","QuestionID":"QID1718715759"}},{"SurveyID":"SV_2hHhyj6NDuZB6WG","Element":"SQ","PrimaryAttribute":"QID1718715760","SecondaryAttribute":"Date of Consent:","TertiaryAttribute":null,"Payload":{"QuestionText":"Date of Consent:","DefaultChoices":false,"QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Date of Consent:","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Date of Consent:","DataExportTag":"DateofConsent","QuestionID":"QID1718715760"}},{"SurveyID":"SV_2hHhyj6NDuZB6WG","Element":"SQ","PrimaryAttribute":"QID1718715761","SecondaryAttribute":"Please complete the captcha","TertiaryAttribute":null,"Payload":{"QuestionText":"Please complete the captcha","DefaultChoices":false,"QuestionType":"Captcha","Selector":"V2","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Align":"left","Theme":"light"},"QuestionDescription":"Please complete the captcha","GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionJS":false,"QuestionText_Unsafe":"Please complete the captcha","DataExportTag":"ConsentCaptcha","QuestionID":"QID1718715761"}},{"SurveyID":"SV_2hHhyj6NDuZB6WG","Element":"SQ","PrimaryAttribute":"QID1718715904","SecondaryAttribute":"Welcome to the Artistic Perception Experiment","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">Welcome to the Artistic Perception Experiment<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Welcome to the Artistic Perception Experiment","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\">Welcome to the Music Perception Experiment<\/div>","DataExportTag":"Intro1","QuestionID":"QID1718715904"}},{"SurveyID":"SV_2hHhyj6NDuZB6WG","Element":"SQ","PrimaryAttribute":"QID1718715905","SecondaryAttribute":"You are about to view the consent form. Please read the form carefully before consenting.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">You are about to view the consent form. <strong>Please read the form carefully before consenting.<\/strong><\/span><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You are about to view the consent form. Please read the form carefully before consenting.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">You are about to view the consent form. <strong>Please read the form carefully before consenting.<\/strong><\/span><\/div>","DataExportTag":"Intro1","QuestionID":"QID1718715905"}},{"SurveyID":"SV_2hHhyj6NDuZB6WG","Element":"SQ","PrimaryAttribute":"QID172","SecondaryAttribute":"What is your level of formal artistic training or experience, such as painting, drawing, sculptur...","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your level of formal artistic training or experience, such as painting, drawing, sculpture, ceramics, photography, and\/or film-video?","DataExportTag":"Experience","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your level of formal artistic training or experience, such as painting, drawing, sculptur...","Choices":{"1":{"Display":"No formal training or experience"},"4":{"Display":"A little formal training or experience"},"5":{"Display":"Moderate formal training or experience"},"6":{"Display":"Extensive formal training or experience"},"7":{"Display":"Very extensive formal training or experience"}},"ChoiceOrder":["1","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID172"}},{"SurveyID":"SV_2hHhyj6NDuZB6WG","Element":"SQ","PrimaryAttribute":"QID173","SecondaryAttribute":"Did you complete this experiment seriously throughout (without responding randomly)?","TertiaryAttribute":null,"Payload":{"Ques
TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please explain your reasoning for your rating on creativity for your responses:","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Please explain your reasoning for your rating on creativity for your responses:","DataExportTag":"5NonFigureMaxCreatRe","QuestionID":"QID161"}},{"SurveyID":"SV_2hHhyj6NDuZB6WG","Element":"SQ","PrimaryAttribute":"QID162","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q162","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID162"}},{"SurveyID":"SV_2hHhyj6NDuZB6WG","Element":"SQ","PrimaryAttribute":"QID163","SecondaryAttribute":"Alex had a new idea for a digital artwork. \u00a0 Alex worked\u00a0with his graphic design and digital sket.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">Alex had a new idea for a digital artwork.<br>\n&nbsp;<br><b>\nAlex worked&nbsp;with his graphic design and digital sketching tools,&nbsp;revising as his work as he went, which created<\/b><b>&nbsp;a&nbsp;digital artwork.<\/b><\/div><div style=\"text-align: center;\">\n<br>\nClick the arrow to see the digital artwork created.<br>\n<br>\nNote that you will be required to stay on the page for at least 8 seconds before proceeding.&nbsp;Please pay close attention to the artwork. <\/div>","DefaultChoices":false,"DataExportTag":"HumanArtistContinued","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Alex had a new idea for a digital artwork. \u00a0 Alex worked\u00a0with his graphic design and digital sket...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID163","QuestionJS":false}},{"SurveyID":"SV_2hHhyj6NDuZB6WG","Element":"SQ","PrimaryAttribute":"QID164","SecondaryAttribute":"Alex had a new idea for a work of digital artwork. Alex developed and input prompts into the AI i...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">Alex had a new idea for a work of digital artwork.<br>\n<br>\n<b>Alex<\/b><strong> developed and input prompts into the AI image generator, revising each prompt as he went, which created a digital artwork.<\/strong><br>\n<br>\nClick the arrow to see the digital artwork created.<br>\n<br>\nNote that you will be required to stay on the page for at least 8 seconds before proceeding. Please pay close attention to the artwork.&nbsp;<\/div>","DefaultChoices":false,"DataExportTag":"AIArtistContinued","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Alex had a new idea for a work of digital artwork. Alex developed and input prompts into the AI i...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID164","QuestionJS":false}},{"SurveyID":"SV_2hHhyj6NDuZB6WG","Element":"SQ","PrimaryAttribute":"QID165","SecondaryAttribute":"Choose one or more races that you consider yourself to be","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[1,2,3,4,5,6,7],"Choices":{"1":{"Display":"White or Caucasian"},"2":{"Display":"Black or African American"},"3":{"Display":"American Indian\/Native American or Alaska Native"},"4":{"Display":"Asian"},"5":{"Display":"Native Hawaiian or Other Pacific Islander"},"6":{"Display":"Other"},"7":{"Display":"Prefer not to say"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"Language":{"DE":{"QuestionText":"W\u00e4hlen Sie eine oder mehrere ethnische Gruppen aus, zu denen Sie sich z\u00e4hlen","Choices":{"1":{"Display":"Wei\u00df oder kaukasisch"},"2":{"Display":"Afroamerikanisch"},"3":{"Display":"Ureinwohner Amerikas oder Alaskas"},"4":{"Display":"Asiatisch"},"5":{"Display":"Ureinwohner von Hawaii oder den anderen Pazifikinseln"},"6":{"Display":"Sonstiges"},"7":{"Display":"Keine Angabe"}}},"EN-GB":{"QuestionText":"Choose one or more races that you consider yourself to be","Choices":{"1":{"Display":"White or Caucasian"},"2":{"Display":"Black or African American"},"3":{"Display":"American Indian\/Native American or Alaska Native"},"4":{"Display":"Asian"},"5":{"Display":"Native Hawaiian or Other Pacific Islander"},"6":{"Display":"Other"},"7":{"Display":"Prefer not to say"}}},"ES":{"QuestionText":"Elija una o m\u00e1s razas a la que cree pertenecer","Choices":{"1":{"Display":"Blanco o cauc\u00e1sico"},"2":{"Display":"Negra o afroamericana"},"3":{"Display":"Indio americano\/Nativo americano\/Nativo de Alaska"},"4":{"Display":"Asi\u00e1tico"},"5":{"Display":"Nativo de Haw\u00e1i o de otras islas del Pac\u00edfico"},"6":{"Display":"Otro"},"7":{"Display":"Prefiero no decirlo"}}},"ES-ES":{"QuestionText":"Seleccione una o m\u00e1s razas con las que se identifique:","Choices":{"1":{"Display":"Blanco o cauc\u00e1sico"},"2":{"Display":"Negro o afroamericano"},"3":{"Display":"Indio americano\/americano nativo o nativo de Alaska"},"4":{"Display":"Asi\u00e1tico\/a"},"5":{"Display":"Nativo de Haw\u00e1i o de otras islas del Pac\u00edfico"},"6":{"Display":"Otros"},"7":{"Display":"Prefiero no decirlo"}}},"FR":{"QuestionText":"Indiquez les origines ethniques auxquelles vous consid\u00e9rez que vous appartenez (plusieurs r\u00e9ponses possibles)","Choices":{"1":{"Display":"Blanc ou caucasien"},"2":{"Display":"Noir(e) ou Afro-Am\u00e9ricain(e)"},"3":{"Display":"Am\u00e9rindien\/Natif am\u00e9ricain ou natif d'Alaska"},"4":{"Display":"Asiatique"},"5":{"Display":"Natif(ve) d'Hawa\u00ef ou des \u00eeles du Pacifique"},"6":{"Display":"Autre"},"7":{"Display":"Ne souhaite pas r\u00e9pondre"}}},"IT":{"QuestionText":"Scegli una o pi\u00f9 etnie a cui ritieni di appartenere","Choices":{"1":{"Display":"Bianco\/a o caucasico\/a"},"2":{"Display":"Nero o Afroamericano"},"3":{"Display":"Nativo\/a indiano d\u2019America\/nativo americano\/a o nativo\/a dell'Alaska"},"4":{"Display":"Asiatico"},"5":{"Display":"Nativo\/a hawaiano\/a o isolano\/a del Pacifico"},"6":{"Display":"Altro"},"7":{"Display":"Preferisco non dirlo"}}},"JA":{"QuestionText":"\u3054\u81ea\u8eab\u306e\u30eb\u30fc\u30c4\u3068\u601d\u308f\u308c\u308b\u4eba\u7a2e\u30921\u3064\u4ee5\u4e0a\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002","Choices":{"1":{"Display":"\u767d\u4eba"},"2":{"Display":"\u9ed2\u4eba\u307e\u305f\u306f\u30a2\u30d5\u30ea\u30ab\u7cfb\u30a2\u30e1\u30ea\u30ab\u4eba"},"3":{"Display":"\u30a2\u30e1\u30ea\u30ab\u5148\u4f4f\u6c11\u307e\u305f\u306f\u30a2\u30e9\u30b9\u30ab\u5148\u4f4f\u6c11"},"4":{"Display":"\u30a2\u30b8\u30a2\u4eba"},"5":{"Display":"\u30cf\u30ef\u30a4\u5148\u4f4f\u6c11\u307e\u305f\u306f\u305d\u306e\u4ed6\u306e\u592a\u5e73\u6d0b\u8af8\u5cf6\u306e\u4f4f\u6c11"},"6":{"Display":"\u305d\u306e\u4ed6"},"7":{"Display":"\u56de\u7b54\u3057\u305f\u304f\u306a\u3044"}}},"KO":{"QuestionText":"\ubcf8\uc778\uc774 \ud574\ub2f9\ub41c\ub2e4\uace0 \uc0dd\uac01\ud558\ub294 \uc778\uc885\uc744 \ud558\ub098 \uc774\uc0c1 \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624.","Choices":{"1":{"Display":"\ubc31\uc778"},"2":{"Display":"\ud751\uc778 \ub610\ub294 \uc544\ud504\ub9ac\uce74\uacc4 \ubbf8\uad6d\uc778"},"3":{"Display":"\
ur rating on creativity for your responses:","DataExportTag":"2FigureMaxCreatResp","QuestionID":"QID46"}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID47","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><img style=\"width: 1024px; height: 1024px; float: right;\" src=\"https:\/\/uclapsych.qualtrics.com\/CP\/Graphic.php?IM=IM_ctKw8eiHzUSiSTY\"><\/div>","DefaultChoices":false,"DataExportTag":"Image3_Figure","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":" ","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID47","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n    \/*Place your JavaScript here to run when the page loads*\/\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n    \/\/ Maintain a global counter to track the image sequence\n    var currentIndex = parseInt(\"${e:\/\/Field\/image_counter}\") || 1; \/\/ Start from 1\n\n    \/\/ Define mapping between Image question IDs and QIDs\n    var imageQIDMap = {\n        \"Image1_Figure\": \"QID15\",\n        \"Image2_Figure\": \"QID16\",\n        \"Image3_Figure\": \"QID47\",\n        \"Image4_Figure\": \"QID62\",\n        \"Image5_Figure\": \"QID77\",\n        \"Image1_Nonfigure\": \"QID183\",\n        \"Image2_Nonfigure\": \"QID185\",\n        \"Image3_Nonfigure\": \"QID188\",\n        \"Image4_Nonfigure\": \"QID190\",\n        \"Image5_Nonfigure\": \"QID192\"\n    };\n\n    \/\/ Get current QID to determine the image block\n    var currentQID = this.getQuestionInfo().QuestionID;\n    console.log(\"Running JavaScript for image block\");\n    console.log(\"Current QID: \" + currentQID);\n\n    \/\/ Reverse lookup to find the Image name\n    var imageName = Object.keys(imageQIDMap).find(key => imageQIDMap[key] === currentQID);\n    if (!imageName) {\n        console.error(\"No match for QID: \" + currentQID);\n        return; \/\/ Exit if no match\n    }\n\n    \/\/ Get the current ArtistHr condition\n    var currentTime = \"${e:\/\/Field\/ArtistHr}\";\n\n    \/\/ Map the current image to the sequential slot (Image1, Image2, etc.)\n    Qualtrics.SurveyEngine.setEmbeddedData(\"Image\" + currentIndex, imageName);\n    Qualtrics.SurveyEngine.setEmbeddedData(\"Image\" + currentIndex + \"_Time\", currentTime);\n\n    console.log(\"Set Embedded Data: Image\" + currentIndex + \" = \" + imageName);\n    console.log(\"Set Embedded Data: Image\" + currentIndex + \"_Time = \" + currentTime);\n\n    \/\/ Increment the counter for the next image\n    currentIndex++;\n    Qualtrics.SurveyEngine.setEmbeddedData(\"image_counter\", currentIndex);\n});\n\nQualtrics.SurveyEngine.addOnUnload(function () {\n    \/*Place your JavaScript here to run when the page is unloaded*\/\n});"}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID48","SecondaryAttribute":"SECOND WORK","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><strong><span style=\"font-size:22px;\">SECOND WORK<\/span><\/strong><br \/>\n<br \/>\n<img src=\"https:\/\/uclapsych.qualtrics.com\/CP\/Graphic.php?IM=IM_0oM0iJEDXudibHw\" \/><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"SECOND WORK","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Click to write the question text","DataExportTag":"Q48","QuestionID":"QID48"}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID49","SecondaryAttribute":"How transformative is the second work compared to the first work? Transformativeness is the degre...","TertiaryAttribute"
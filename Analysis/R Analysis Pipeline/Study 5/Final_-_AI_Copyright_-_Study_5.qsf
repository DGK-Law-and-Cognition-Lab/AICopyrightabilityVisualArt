,"SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><img src=\"https:\/\/uclapsych.qualtrics.com\/CP\/Graphic.php?IM=IM_bOzN9fgiJO3ptLU\" style=\"width: 1024px; height: 1024px;\" \/><\/div>","DefaultChoices":false,"DataExportTag":"Image1_Figure","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":" ","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID15","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n    \/*Place your JavaScript here to run when the page loads*\/\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n    \/\/ Maintain a global counter to track the image sequence\n    var currentIndex = parseInt(\"${e:\/\/Field\/image_counter}\") || 1; \/\/ Start from 1\n\n    \/\/ Define mapping between Image question IDs and QIDs\n    var imageQIDMap = {\n        \"Image1_Figure\": \"QID15\",\n        \"Image2_Figure\": \"QID16\",\n        \"Image3_Figure\": \"QID47\",\n        \"Image4_Figure\": \"QID62\",\n        \"Image5_Figure\": \"QID77\",\n        \"Image1_Nonfigure\": \"QID183\",\n        \"Image2_Nonfigure\": \"QID185\",\n        \"Image3_Nonfigure\": \"QID188\",\n        \"Image4_Nonfigure\": \"QID190\",\n        \"Image5_Nonfigure\": \"QID192\"\n    };\n\n    \/\/ Get current QID to determine the image block\n    var currentQID = this.getQuestionInfo().QuestionID;\n    console.log(\"Running JavaScript for image block\");\n    console.log(\"Current QID: \" + currentQID);\n\n    \/\/ Reverse lookup to find the Image name\n    var imageName = Object.keys(imageQIDMap).find(key => imageQIDMap[key] === currentQID);\n    if (!imageName) {\n        console.error(\"No match for QID: \" + currentQID);\n        return; \/\/ Exit if no match\n    }\n\n    \/\/ Get the current ArtistHr condition\n    var currentTime = \"${e:\/\/Field\/ArtistHr}\";\n\n    \/\/ Map the current image to the sequential slot (Image1, Image2, etc.)\n    Qualtrics.SurveyEngine.setEmbeddedData(\"Image\" + currentIndex, imageName);\n    Qualtrics.SurveyEngine.setEmbeddedData(\"Image\" + currentIndex + \"_Time\", currentTime);\n\n    console.log(\"Set Embedded Data: Image\" + currentIndex + \" = \" + imageName);\n    console.log(\"Set Embedded Data: Image\" + currentIndex + \"_Time = \" + currentTime);\n\n    \/\/ Increment the counter for the next image\n    currentIndex++;\n    Qualtrics.SurveyEngine.setEmbeddedData(\"image_counter\", currentIndex);\n});\n\nQualtrics.SurveyEngine.addOnUnload(function () {\n    \/*Place your JavaScript here to run when the page is unloaded*\/\n});"}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID150","SecondaryAttribute":"How much has the essence of the first work changed in the second work? Essence refers to the core...","TertiaryAttribute":null,"Payload":{"QuestionText":"How much has the essence of the first work changed in the second work?<br><br>Essence refers to the core sense and feeling that one has while observing a work of art that makes that work unique.<br>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"How much has the essence of the first work changed in the second work? Essence refers to the core...","Choices":{"1":{"Display":"No change in essence"},"10":{"Display":"Very little change in essence"},"13":{"Display":"Moderate change in essence"},"14":{"Display":"Significant change in essence"},"15":{"Display":"Complete change in essence"}},"ChoiceOrder":["1","10","13","14","15"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId
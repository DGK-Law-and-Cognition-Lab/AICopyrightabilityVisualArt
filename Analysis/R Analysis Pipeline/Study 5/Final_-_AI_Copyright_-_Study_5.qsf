alse"},"QuestionText_Unsafe":"Please explain your reasoning for your rating on essence for your responses:","DataExportTag":"5NonFigureMaxEssResp","QuestionID":"QID160"}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID161","SecondaryAttribute":"Please explain your reasoning for your rating on creativity for your responses:","TertiaryAttribute":null,"Payload":{"QuestionText":"Please explain your reasoning for your rating on creativity for your responses:","DefaultChoices":false,"QuestionType":"TE","Selector":"ESTB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please explain your reasoning for your rating on creativity for your responses:","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Please explain your reasoning for your rating on creativity for your responses:","DataExportTag":"5NonFigureMaxCreatRe","QuestionID":"QID161"}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID162","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q162","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID162"}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID163","SecondaryAttribute":"Alex had a new idea for a digital artwork. \u00a0 Alex spent ${e:\/\/Field\/ArtistHr_Source} working with..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">Alex had a new idea for a digital artwork.<\/div>\n\n<div style=\"text-align: center;\">&nbsp;<\/div>\n\n<div style=\"text-align: center;\">Alex spent <strong><span style=\"color:#c0392b;\">${e:\/\/Field\/ArtistHr_Source}<\/span> working with his graphic design and digital sketching tools,<\/strong>&nbsp;revising as his work as he goes, which creates a&nbsp;digital artwork.<br>\n<br>\nClick the arrow to see the digital artwork created.<br>\n<br>\nNote that you will be required to stay on the page for at least 8 seconds before proceeding.<\/div>","DefaultChoices":false,"DataExportTag":"HumanArtistContinued","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Alex had a new idea for a digital artwork. \u00a0 Alex spent ${e:\/\/Field\/ArtistHr_Source} working with...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID163","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n    \/* Place your JavaScript here to run when the page loads *\/\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n    \/\/ Get the question text element\n    var questionTextElement = this.getQuestionTextContainer();\n    \n    \/\/ Retrieve existing counts with more robust parsing\n    var hour1_count = parseInt(Qualtrics.SurveyEngine.getEmbeddedData(\"hour1_count\")) || 0;\n    var hour10_count = parseInt(Qualtrics.SurveyEngine.getEmbeddedData(\"hour10_count\")) || 0;\n    var hour100_count = parseInt(Qualtrics.SurveyEngine.getEmbeddedData(\"hour100_count\")) || 0;\n    \n    \/\/ Check total count\n    var totalCount = hour1_count + hour10_count + hour100_count;\n    if (totalCount >= 6) {\n        console.error(\"All six conditions already assigned. No further assignments.\");\n        return;\n    }\n    \n    \/\/ Define available conditions\n    var conditions = [\n        { time: \"less than 1 hour\", count: hour1_count, max: 2 },\n        { time: \"10 hours\", count: hour10_count, max: 2 },\n        { time: \"100 hours\", count: hour100_count, max: 2 }\n    ];\n    \n    \/\/ Filter available conditions\n    var availableConditions = conditions.filter(c => c.count < c.max);\n    \n    \/\/ Randomly select from available conditions\n    var selectedCondition = availableConditions[Math.floor(Math.random() * availableConditions.length)];\n    var selectedTime = selectedCondition.time;\n    \n    \/\/ Update counts\n    if (selectedTime === \"less than 1 hour\") {\n        hour1_count++;\n    } else if (selectedTime === \"10 hours\") {\n        hour10_count++;\n    } else if (selectedTime === \"100 hours\") {\n        hour100_count++;\n    }\n    \n    \/\/ Update embedded data\n    Qualtrics.SurveyEngine.setEmbeddedData(\"ArtistHr_Source\", selectedTime);\n    Qualtrics.SurveyEngine.setEmbeddedData(\"hour1_count\", hour1_count);\n    Qualtrics.SurveyEngine.setEmbeddedData(\"hour10_count\", hour10_count);\n    Qualtrics.SurveyEngine.setEmbeddedData(\"hour100_count\", hour100_count);\n    \n    \/\/ Force update the question text\n    var questionText = questionTextElement.innerHTML;\n    questionText = questionText.replace(\"${e:\/\/Field\/ArtistHr_Source}\", selectedTime);\n    questionTextElement.innerHTML = questionText;\n    \n    \/\/ Log for debugging\n    console.log(\"Selected time: \" + selectedTime);\n    console.log(\"Updated counts - 1hr: \" + hour1_count + \", 10hr: \" + hour10_count + \", 100hr: \" + hour100_count);\n});\n\nQualtrics.SurveyEngine.addOnUnload(function () {\n    \/* Place your JavaScript here to run when the page is unloaded *\/\n});"}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID164","SecondaryAttribute":"Alex had a new idea for a work of digital artwork. \u00a0 Alex spent ${e:\/\/Field\/ArtistHr_Source} deve..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">Alex had a new idea for a work of digital artwork.<\/div>\n\n<div style=\"text-align: center;\">&nbsp;<\/div>\n\n<div style=\"text-align: center;\">Alex spent <b><span style=\"color:#c0392b;\">${e:\/\/Field\/ArtistHr_Source}<\/span> developing and inputting prompts into the AI image generator<\/b>, revising each prompt as he goes, which creates a digital artwork.<\/div>\n\n<div style=\"text-align: center;\"><br>\nClick the arrow to see the digital artwork created.<br>\n<br>\nNote that you will be required to stay on the page for at least 8 seconds before proceeding.<\/div>","DefaultChoices":false,"DataExportTag":"AIArtistContinued","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Alex had a new idea for a work of digital artwork. \u00a0 Alex spent ${e:\/\/Field\/ArtistHr_Source} deve...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID164","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n    \/* Place your JavaScript here to run when the page loads *\/\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n    \/\/ Get the question text element\n    var questionTextElement = this.getQuestionTextContainer();\n    \n    \/\/ Retrieve existing counts with more robust parsing\n    var hour1_count = parseInt(Qualtrics.SurveyEngine.getEmbeddedData(\"hour1_count\")) || 0;\n    var hour10_count = parseInt(Qualtrics.SurveyEngine.getEmbeddedData(\"hour10_count\")) || 0;\n    var hour100_count = parseInt(Qualtrics.SurveyEngine.getEmbeddedData(\"hour100_count\")) || 0;\n    \n    \/\/ Check total count\n    var totalCount = hour1_count + hour10_count + hour100_count;\n    if (totalCount >= 6) {\n        console.error(\"All six conditions already assigned. No further assignments.\");\n        return;\n    }\n    \n    \/\/ Define available conditions\n    var conditions = [\n        { time: \"less than 1 hour\", count: hour1_count, max: 2 },\n        { time: \"10 hours\", count: hour10_count, max: 2 },\n        { time: \"100 hours\", count: hour100_count, max: 2 }\n    ];\n    \n    \/\/ Filter available conditions\n    var availableConditions = conditions.filter(c => c.count < c.max);\n    \n    \/\/ Randomly select from available conditions\n    var selectedCondition = availableConditions[Math.floor(Math.random() * availableConditions.length)];\n    var selectedTime = selectedCondition.time;\n    \n    \/\/ Update counts\n    if (selectedTime === \"less than 1 hour\") {\n        hour1_count++;\n    } else if (selectedTime === \"10 hours\") {\n        hour10_count++;\n    } else if (selectedTime === \"100 hours\") {\n        hour100_count++;\n    }\n    \n    \/\/ Update embedded data\n    Qualtrics.SurveyEngine.setEmbeddedData(\"ArtistHr_Source\", selectedTime);\n    Qualtrics.SurveyEngine.setEmbeddedData(\"hour1_count\", hour1_count);\n    Qualtrics.SurveyEngine.setEmbeddedData(\"hour10_count\", hour10_count);\n    Qualtrics.SurveyEngine.setEmbeddedData(\"hour100_count\", hour100_count);\n    \n    \/\/ Force update the question text\n    var questionText = questionTextElement.innerHTML;\n    questionText = questionText.replace(\"${e:\/\/Field\/ArtistHr_Source}\", selectedTime);\n    questionTextElement.innerHTML = questionText;\n    \n    \/\/ Log for debugging\n    console.log(\"Selected time: \" + selectedTime);\n    console.log(\"Updated counts - 1hr: \" + hour1_count + \", 10hr: \" + hour10_count + \", 100hr: \" + hour100_count);\n});\n\nQualtrics.SurveyEngine.addOnUnload(function () {\n    \/* Place your JavaScript here to run when the page is unloaded *\/\n});"}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID165","SecondaryAttribute":"Choose one or more races that you consider yourself to be","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[1,2,3,4,5,6,7],"Choices":{"1":{"Display":"White or Caucasian"},"2":{"Display":"Black or African American"},"3":{"Display":"American Indian\/Native American or Alaska Native"},"4":{"Display":"Asian"},"5":{"Display":"Native Hawaiian or Other Pacific Islander"},"6":{"Display":"Other"},"7":{"Display":"Prefer not to say"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"Language":{"DE":{"QuestionText":"W\u00e4hlen Sie eine oder mehrere ethnische Gruppen aus, zu denen Sie sich z\u00e4hlen","Choices":{"1":{"Display":"Wei\u00df oder kaukasisch"},"2":{"Display":"Afroamerikanisch"},"3":{"Display":"Ureinwohner Amerikas oder Alaskas"},"4":{"Display":"Asiatisch"},"5":{"Display":"Ureinwohner von Hawaii oder den anderen Pazifikinseln"},"6":{"Display":"Sonstiges"},"7":{"Display":"Keine Angabe"}}},"EN-GB":{"QuestionText":"Choose one or more races that you consider yourself to be","Choices":{"1":{"Display":"White or Caucasian"},"2":{"Display":"Black or African American"},"3":{"Display":"American Indian\/Native American or Alaska Native"},"4":{"Display":"Asian"},"5":{"Display":"Native Hawaiian or Other Pacific Islander"},"6":{"Display":"Other"},"7":{"Display":"Prefer not to say"}}},"ES":{"QuestionText":"Elija una o m\u00e1s razas a la que cree pertenecer","Choices":{"1":{"Display":"Blanco o cauc\u00e1sico"},"2":{"Display":"Negra o afroamericana"},"3":{"Display":"Indio americano\/Nativo americano\/Nativo de Alaska"},"4":{"Display":"Asi\u00e1tico"},"5":{"Display":"Nativo de Haw\u00e1i o de otras islas del Pac\u00edfico"},"6":{"Display":"Otro"},"7":{"Display":"Prefiero no decirlo"}}},"ES-ES":{"QuestionText":"Seleccione una o m\u00e1s razas con las que se identifique:","Choices":{"1":{"Display":"Blanco o cauc\u00e1sico"},"2":{"Display":"Negro o afroamericano"},"3":{"Display":"Indio americano\/americano nativo o nativo de Alaska"},"4":{"Display":"Asi\u00e1tico\/a"},"5":{"Display":"Nativo de Haw\u00e1i o de otras islas del Pac\u00edfico"},"6":{"Display":"Otros"},"7":{"Display":"Prefiero no decirlo"}}},"FR":{"QuestionText":"Indiquez les origines ethniques auxquelles vous consid\u00e9rez que vous appartenez (plusieurs r\u00e9ponses possibles)","Choices":{"1":{"Display":"Blanc ou caucasien"},"2":{"Display":"Noir(e) ou Afro-Am\u00e9ricain(e)"},"3":{"Display":"Am\u00e9rindien\/Natif am\u00e9ricain ou natif d'Alaska"},"4":{"Display":"Asiatique"},"5":{"Display":"Natif(ve) d'Hawa\u00ef ou des \u00eeles du Pacifique"},"6":{"Display":"Autre"},"7":{"Display":"Ne souhaite pas r\u00e9pondre"}}},"IT":{"QuestionText":"Scegli una o pi\u00f9 etnie a cui ritieni di appartenere","Choices":{"1":{"Display":"Bianco\/a o caucasico\/a"},"2":{"Display":"Nero o Afroamericano"},"3":{"Display":"Nativo\/a indiano d\u2019America\/nativo americano\/a o nativo\/a dell'Alaska"},"4":{"Display":"Asiatico"},"5":{"Display":"Nativo\/a hawaiano\/a o isolano\/a del Pacifico"},"6":{"Display":"Altro"},"7":{"Display":"Preferisco non dirlo"}}},"JA":{"QuestionText":"\u3054\u81ea\u8eab\u306e\u30eb\u30fc\u30c4\u3068\u601d\u308f\u308c\u308b\u4eba\u7a2e\u30921\u3064\u4ee5\u4e0a\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002","Choices":{"1":{"Display":"\u767d\u4eba"},"2":{"Display":"\u9ed2\u4eba\u307e\u305f\u306f\u30a2\u30d5\u30ea\u30ab\u7cfb\u30a2\u30e1\u30ea\u30ab\u4eba"},"3":{"Display":"\u30a2\u30e1\u30ea\u30ab\u5148\u4f4f\u6c11\u307e\u305f\u306f\u30a2\u30e9\u30b9\u30ab\u5148\u4f4f\u6c11"},"4":{"Display":"\u30a2\u30b8\u30a2\u4eba"},"5":{"Display":"\u30cf\u30ef\u30a4\u5148\u4f4f\u6c11\u307e\u305f\u306f\u305d\u306e\u4ed6\u306e\u592a\u5e73\u6d0b\u8af8\u5cf6\u306e\u4f4f\u6c11"},"6":{"Display":"\u305d\u306e\u4ed6"},"7":{"Display":"\u56de\u7b54\u3057\u305f\u304f\u306a\u3044"}}},"KO":{"QuestionText":"\ubcf8\uc778\uc774 \ud574\ub2f9\ub41c\ub2e4\uace0 \uc0dd\uac01\ud558\ub294 \uc778\uc885\uc744 \ud558\ub098 \uc774\uc0c1 \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624.","Choices":{"1":{"Display":"\ubc31\uc778"},"2":{"Display":"\ud751\uc778 \ub610\ub294 \uc544\ud504\ub9ac\uce74\uacc4 \ubbf8\uad6d\uc778"},"3":{"Display":"\uc544\uba54\ub9ac\uce74 \uc778\ub514\uc5b8\/\uc544\uba54\ub9ac\uce74 \uc6d0\uc8fc\ubbfc \ub610\ub294 \uc54c\ub798\uc2a4\uce74 \uc6d0\uc8fc\ubbfc"},"4":{"Display":"\uc544\uc2dc\uc544\uc778"},"5":{"Display":"\ud558\uc640\uc774 \uc6d0\uc8fc\ubbfc \ub610\ub294 \uae30\ud0c0 \ud0dc\ud3c9\uc591\uc758 \uc12c \uc8fc\ubbfc"},"6":{"Display":"\uae30\ud0c0"},"7":{"Display":"\uc5b8\uae09 \uc548 \ud568"}}},"NL":{"QuestionText":"Kies een of meerdere rassen waartoe u volgens uzelf behoort","Choices":{"1":{"Display":"Blank"},"2":{"Display":"Zwart of Afro-Amerikaans"},"3":{"Display":"Amerikaans Indiaans\/native Amerikaans of afkomstig uit Alaska"},"4":{"Display":"Aziatisch"},"5":{"Display":"Geboren op Hawa\u00ef of een ander eiland in de Stille Oceaan"},"6":{"Display":"Anders"},"7":{"Display":"Ik antwoord liever niet"}}},"PT-BR":{"QuestionText":"Escolha uma ou mais ra\u00e7as com as quais voc\u00ea se identifica","Choices":{"1":{"Display":"Branco ou caucasiano"},"2":{"Display":"Negro ou afro-americano"},"3":{"Display":"Amer\u00edndio\/Nativo americano ou nativo do Alasca"},"4":{"Display":"Asi\u00e1tico"},"5":{"Display":"Nativo do Hava\u00ed ou de outra ilha do Pac\u00edfico"},"6":{"Display":"Outro"},"7":{"Display":"Prefiro n\u00e3o dizer"}}},"ZH-S":{"QuestionText":"\u9009\u62e9\u60a8\u8ba4\u4e3a\u81ea\u5df1\u6240\u5c5e\u7684\u4e00\u4e2a\u6216\u591a\u4e2a\u79cd\u65cf","Choices":{"1":{"Display":"\u767d\u4eba\u6216\u9ad8\u52a0\u7d22\u4eba"},"2":{"Display":"\u9ed1\u4eba\u6216\u975e\u6d32\u88d4\u7f8e\u56fd\u4eba"},"3":{"Display":"\u7f8e\u6d32\u5370\u7b2c\u5b89\u4eba\/\u5370\u7b2c\u5b89\u4eba\u6216\u963f\u62c9\u65af\u52a0\u539f\u4f4f\u6c11"},"4":{"Display":"\u4e9a\u88d4"},"5":{"Display":"\u590f\u5a01\u5937\u571f\u8457\u6216\u5176\u4ed6\u592a\u5e73\u6d0b\u5c9b\u6c11"},"6":{"Display":"\u5176\u4ed6"},"7":{"Display":"\u4fdd\u5bc6"}}},"ZH-T":{"QuestionText":"\u9078\u64c7\u60a8\u8a8d\u70ba\u81ea\u5df1\u5c6c\u65bc\u7684\u4e00\u6216\u591a\u500b\u7a2e\u65cf","Choices":{"1":{"Display":"\u767d\u4eba\u6216\u9ad8\u52a0\u7d22\u4eba"},"2":{"Display":"\u9ed1\u4eba\u6216\u975e\u6d32\u88d4\u7f8e\u570b\u4eba"},"3":{"Display":"\u7f8e\u6d32\u5370\u5730\u5b89\u4eba\/\u7f8e\u570b\u6216\u963f\u62c9\u65af\u52a0\u539f\u4f4f\u6c11"},"4":{"Display":"\u4e9e\u6d32\u4eba"},"5":{"Display":"\u590f\u5a01\u5937\u539f\u4f4f\u6c11\u6216\u592a\u5e73\u6d0b\u8af8\u5cf6\u4f4f\u6c11"},"6":{"Display":"\u5176\u4ed6"},"7":{"Display":"\u4e0d\u9858\u900f\u9732"}}}},"NextAnswerId":1,"NextChoiceId":8,"QuestionDescription":"Choose one or more races that you consider yourself to be","QuestionText":"Choose one or more races that you consider yourself to be","QuestionText_Unsafe":"Choose one or more races that you consider yourself to be","QuestionType":"MC","ReferenceQuestionConfig":{"instanceOf":{"id":"RQ_xvqnQ9VTmsxnvtM","version":"v2.0.0"}},"SchemaConfig":{"ChoiceMapping":{"1":"enu:\/\/White","2":"enu:\/\/Black","3":"enu:\/\/AmericanIndian","4":"enu:\/\/Asian","5":"enu:\/\/Hawaiian","6":"enu:\/\/Other","7":"enu:\/\/PreferNotToSay"},"ChoiceMappingType":"Member","ConfigVersion":"1.0.0","Reconfirm":true,"URL":"ses:\/\/USRace","XMDConnect":true},"Selector":"MAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"DataExportTag":"Race","QuestionID":"QID165"}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID166","SecondaryAttribute":"You have now completed the main experiment, and are progressing onto debriefing questions.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">You have now completed the main experiment, and are progressing onto debriefing questions.<\/div>","DefaultChoices":false,"DataExportTag":"ProgresstoDebrief","QuestionID":"QID166","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You have now completed the main experiment, and are progressing onto debriefing questions.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID167","SecondaryAttribute":"Was any part of the procedure unclear? Did you have any problems completing any of the tasks? If...","TertiaryAttribute":null,"Payload":{"QuestionText":"Was any part of the procedure unclear? Did you have any problems completing any of the tasks? If none, type NA.","DefaultChoices":false,"DataExportTag":"CommentFeedback","QuestionID":"QID167","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Was any part of the procedure unclear? Did you have any problems completing any of the tasks? If...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID168","SecondaryAttribute":"What is your gender?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your gender?","DataExportTag":"Gender","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your gender?","Choices":{"1":{"Display":"Male"},"2":{"Display":"Female"},"3":{"Display":"Other"},"4":{"Display":"Prefer not to say"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID168"}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID169","SecondaryAttribute":"What is your age?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your age?","DefaultChoices":false,"DataExportTag":"Age","QuestionID":"QID169","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your age?","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"Alex looked at the first artwork. \u00a0 He decided to produced a secondary digital artwork.\u00a0 \u00a0 Using.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">Alex looked at the <b>first artwork.<\/b><\/div>\n\n<div style=\"text-align: center;\">&nbsp;<\/div>\n\n<div style=\"text-align: center;\">He decided to produced <b>a secondary digital artwork<\/b>.&nbsp;<\/div>\n\n<div style=\"text-align: center;\">&nbsp;<\/div><div style=\"text-align: center;\">\nUsing the <strong>first artwork<\/strong> as a base, he spent <strong><span style=\"color:#c0392b;\">${e:\/\/Field\/ArtistHr_Derivative}<\/span><\/strong> producing&nbsp;<b>a second digital artwork<\/b> <i>with his own graphic design skills and digital sketching tools<b style=\"\">.<\/b><\/i><br>\n<br>\nClick the arrow to see the digital artworks:<\/div>","DefaultChoices":false,"DataExportTag":"SecondPartVignette1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Alex looked at the first artwork. \u00a0 He decided to produced a secondary digital artwork.\u00a0 \u00a0 Using...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID17","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function() {\n    \/\/ Log where we are\n    console.log(\"SecondPartVignette1 block started\");\n    \n    \/\/ Get current image index and its stored time\n    var currentImageIndex = parseInt(\"${e:\/\/Field\/currentImageIndex}\") || 1;\n    var storedTime = Qualtrics.SurveyEngine.getEmbeddedData('image_' + currentImageIndex + '_time');\n    \n    \/\/ Ensure we have the correct time for this image\n    if (storedTime) {\n        console.log(\"Vignette1: Using stored time for image \" + currentImageIndex + \": \" + storedTime);\n        Qualtrics.SurveyEngine.setEmbeddedData('CurrentArtworkTime', storedTime);\n    } else {\n        console.log(\"WARNING: No stored time found for image \" + currentImageIndex);\n    }\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID170","SecondaryAttribute":"We are studying how humans perceive the copyrightability of artificial intelligence art. Current...","TertiaryAttribute":null,"Payload":{"QuestionText":"We are studying how humans perceive the copyrightability of artificial intelligence art. Current legal standards state that anything produced with artificial intelligence is insufficiently creative, even if you use AI as a base against which you create new work. There is ongoing litigation against the US Copyright Office with an analogous set of facts that you have seen here. If you have any questions, please feel free to contact the researcher David G. Kamper at davidgkamper@ucla.edu.","DefaultChoices":false,"DataExportTag":"Final Review","QuestionID":"QID170","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"We are studying how humans perceive the copyrightability of artificial intelligence art. Current...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID171","SecondaryAttribute":"Please select the \"arrow\" button to complete the experiment","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\">Please select the &quot;arrow&quot; button to complete the experiment<\/div>","DefaultChoices":false,"DataExportTag":"Finish","QuestionID":"QID171","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please select the \"arrow\" button to complete the experiment","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID1718715759","SecondaryAttribute":"CONSENT FORM You are invited to participate in a research study on human thinking and artistic an...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><b>CONSENT FORM<\/b><\/div><br>You are invited to participate in a research study on human thinking and artistic and aesthetic judgment, conducted by Dr. Keith J. Holyoak, of the Department of Psychology at UCLA. You were selected as a possible participant in this study because you are 18 years of age or older.\n<br>\n<br>\n<b>Purpose of Study<\/b><br>\nThe purpose of the study is to understand human artistic perception and cognition.\n<br>\n<br>\n<b>Procedures Involved in Study<\/b><br>\nIf you agree to participate, you may receive a demographic questionnaire to collect information on your age, gender, language, and artistic background. You may be presented with different types of visual art and asked to answer simple questions and\/or perform simple tasks by interacting with a website via a keyboard or a computer mouse. Your responses will be recorded by the computer and will not be identified with you in any way. The session will take less than 60 minutes.\n<br>\n<br>\n<b>Potential Risks and Discomforts<\/b><br>\nThere is no known risk or discomfort in this study. If you experience any discomfort during the experiment, you can stop at any time and notify the experimenter.<br>\n<br>\n<b>Potential Benefits to Subject<\/b><br>\nThere are no direct benefits from participating in this study.<br>\n<br>\n<b>Potential Benefits to Society<\/b><br>\nThe findings of the study will help us understand how humans perceive and understand aesthetic judgements in the law. By understanding the processes underlying human perception, we can better consider the fundamentals of copyright and the burgeoning field of AI art.  \n<br>\n<br>\n<b>Payment for Participation<\/b><br>\nYou will receive 0.5 to 1 hour of credit for your psychology class if you signed up for the study through the UCLA Psychology Department Subject Pool; otherwise, you will receive payment at the rate of $16 per hour for your participation.<br>\n<br>\n<b>Alternatives to Participation<\/b><br>\nAn alternative to participating in this project and fulfilling Psychology 10 requirements is to participate in other research or to do an equivalent classroom project.<br>\n<br>\n<b>Confidentiality<\/b><br>\nYour identity in this study will be treated as confidential. The results of the study, including laboratory or any other data, may be published for scientific purposes but will not include any identifiable references to you. Your data, including de-identified data, may be kept for use in future research. After the experiment has finished running, all contact information will be destroyed. Only the researchers will have access to registration and data files. The data files that you submit will be stored for 5 years.<br>\n<br>\nThe researchers will do their best to ensure that your private information is kept confidential. Information about you will be handled as confidentially as possible, but participating in research may involve a loss of privacy and the potential for a breach in confidentiality. Study data will be physically and electronically secured. As with any use of electronic means to store data, there is a risk of breach of data security.<br>\n<br>\n<b>Participation and Withdrawal<\/b><br>\nYour participation is VOLUNTARY. You may withdraw from the experiment at any time without suffering any negative consequences. You may refuse to answer any questions that you do not want to answer and remain in the study.<br>\n<br>\n<b>Identification of Investigators<\/b><br>\nIf you have any questions, feel free to contact Co-Principal Investigator David G. Kamper (davidgkamper@ucla.edu) or Principal Investigator Keith Holyoak (kholyoak@g.ucla.edu) at the Department of Psychology, UCLA, 405 Hilgard Ave., Los Angeles, CA 90095-1563. <br>\n<br>\n<b>Rights of Research Subjects<\/b><br>\nYou may withdraw your consent at any time and discontinue participation without penalty. You are not waiving any legal claims, rights, or remedies because of your participation in this research study.<br>\n<br>\n<b>UCLA Office of the Human Research Protection Program (OHRPP)<\/b><br>\nIf you have questions about your rights as a research subject, or you have concerns or suggestions and you want to talk to someone other than the researchers, you may contact the UCLA OHRPP by phone: (310) 206-2040; by email: participants@research.ucla.edu or by mail: Box 951406, Los Angeles, CA 90095-1406.","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"CONSENT FORM You are invited to participate in a research study on human thinking and artistic an...","Choices":{"1":{"Display":"I consent to this study."},"2":{"Display":"I do not consent to this study."}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionText_Unsafe":"<div style=\"text-align: center;\"><b>CONSENT FORM<\/b><\/div><br>You are invited to participate in a research study on human thinking and music, conducted by Dr. Keith J. Holyoak, of the Department of Psychology at UCLA. You were selected as a possible participant in this study because you are 18 years of age or older.<br>\n<br>\n<b>Purpose of Study<\/b><br>\nThe purpose of the study is to understand human auditory perception and cognition.<br>\n<br>\n<b>Procedures Involved in Study<\/b><br>\nIf you agree to participate, you may receive a demographic questionnaire to collect information on your age, gender, language, and musical background. You may be presented with audio clips and asked to answer simple questions and\/or perform simple tasks by interacting with a website via a keyboard or a computer mouse. Your responses will be recorded by the computer and will not be identified with you in any way. The session will take less than 60 minutes.<br>\n<br>\n<b>Potential Risks and Discomforts<\/b><br>\nThere is no known risk or discomfort in this study. If you experience any discomfort during the experiment, you can stop at any time and notify the experimenter.<br>\n<br>\n<b>Potential Benefits to Subject<\/b><br>\nThere are no direct benefits from participating in this study.<br>\n<br>\n<b>Potential Benefits to Society<\/b><br>\nThe findings of the study will help us understand how humans perceive and understand musical similarity. By understanding the processes underlying human perception, we will be able to design better machine vision systems.<br>\n<br>\n<b>Payment for Participation<\/b><br>\nYou will receive 1 hour of credit for your psychology class if you signed up for the study through the UCLA Psychology Department Subject Pool; otherwise, you will receive payment at the rate of $10 per hour for your participation.<br>\n<br>\n<b>Alternatives to Participation<\/b><br>\nAn alternative to participating in this project and fulfilling Psychology 10 requirements is to participate in other research or to do an equivalent classroom project.<br>\n<br>\n<b>Confidentiality<\/b><br>\nYour identity in this study will be treated as confidential. The results of the study, including laboratory or any other data, may be published for scientific purposes but will not include any identifiable references to you. Your data, including de-identified data, may be kept for use in future research. After the experiment has finished running, all contact information will be destroyed. Only the researchers will have access to registration and data files. The data files that you submit will be stored for 5 years.<br>\n<br>\nThe researchers will do their best to ensure that your private information is kept confidential. Information about you will be handled as confidentially as possible, but participating in research may involve a loss of privacy and the potential for a breach in confidentiality. Study data will be physically and electronically secured. As with any use of electronic means to store data, there is a risk of breach of data security.<br>\n<br>\n<b>Participation and Withdrawal<\/b><br>\nYour participation is VOLUNTARY. You may withdraw from the experiment at any time without suffering any negative consequences. You may refuse to answer any questions that you do not want to answer and remain in the study.<br>\n<br>\n<b>Identification of Investigators<\/b><br>\nIf you have any questions, feel free to contact Co-Principal Investigator David G. Kamper (davidgkamper@ucla.edu) or Principal Investigator Keith Holyoak (kholyoak@g.ucla.edu) at the Department of Psychology, UCLA, 405 Hilgard Ave., Los Angeles, CA 90095-1563.<br>\n<br>\n<b>Rights of Research Subjects<\/b><br>\nYou may withdraw your consent at any time and discontinue participation without penalty. You are not waiving any legal claims, rights, or remedies because of your participation in this research study.<br>\n<br>\n<b>UCLA Office of the Human Research Protection Program (OHRPP)<\/b><br>\nIf you have questions about your rights as a research subject, or you have concerns or suggestions and you want to talk to someone other than the researchers, you may contact the UCLA OHRPP by phone: (310) 206-2040; by email: participants@research.ucla.edu or by mail: Box 951406, Los Angeles, CA 90095-1406.","DataExportTag":"ConsentForm","QuestionID":"QID1718715759"}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID1718715760","SecondaryAttribute":"Date of Consent:","TertiaryAttribute":null,"Payload":{"QuestionText":"Date of Consent:","DefaultChoices":false,"QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":580,"InputHeight":29},"QuestionDescription":"Date of Consent:","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"Date of Consent:","DataExportTag":"DateofConsent","QuestionID":"QID1718715760"}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID1718715761","SecondaryAttribute":"Please complete the captcha","TertiaryAttribute":null,"Payload":{"QuestionText":"Please complete the captcha","DefaultChoices":false,"QuestionType":"Captcha","Selector":"V2","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Align":"left","Theme":"light"},"QuestionDescription":"Please complete the captcha","GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionJS":false,"QuestionText_Unsafe":"Please complete the captcha","DataExportTag":"ConsentCaptcha","Q
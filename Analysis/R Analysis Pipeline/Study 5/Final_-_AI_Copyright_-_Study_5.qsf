b><\/div><div style=\"text-align: center;\"><b>You will be shown the two secondary digital artworks alongside the first produced artwork in succession, and answer questions about&nbsp;them&nbsp;in between.<\/b><\/div><div style=\"text-align: center;\">\n<br>\n&nbsp;Click the arrow to see the digital artworks:<\/div>","DataExportTag":"SecondPartVignette2","QuestionID":"QID236","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function() {\n    \/\/ Log where we are\n    console.log(\"SecondPartVignette2 block started\");\n    \n    \/\/ Get current image index and its stored time\n    var currentImageIndex = parseInt(\"${e:\/\/Field\/currentImageIndex}\") || 1;\n    var storedTime = Qualtrics.SurveyEngine.getEmbeddedData('image_' + currentImageIndex + '_time');\n    \n    \/\/ Ensure we have the correct time for this image\n    if (storedTime) {\n        console.log(\"Vignette2: Using stored time for image \" + currentImageIndex + \": \" + storedTime);\n        Qualtrics.SurveyEngine.setEmbeddedData('CurrentArtworkTime', storedTime);\n    } else {\n        console.log(\"WARNING: No stored time found for image \" + currentImageIndex);\n    }\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_1TZIWvMfrSM58Fw","Element":"SQ","PrimaryAttribute":"QID237","SecondaryAttribute":"What does 8+7 equal?","TertiaryAttribute":null,"Payload":{"QuestionText":"What does 8+7 equal?","DefaultChoices":false,"DataExportTag":"AttentionCheck2","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What does 8+7 equal?","Choices":{"1":{"Display":"15"},"2":{"Display":"14"},"3":{"Display":"16"},"4":{"Display":"17"},"5":{"Display":"18"}},"ChoiceOrder